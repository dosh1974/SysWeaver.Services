<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RootNamespace>SysWeaver</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SysWeaver\Compression\SysWeaver.Compression.ZstdSharp\SysWeaver.Compression.ZstdSharp.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.HttpServer.ExploreModule\SysWeaver.HttpServer.ExploreModule.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.HttpServer.IconModule\SysWeaver.HttpServer.IconModule.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.HttpTransformer.Compress\SysWeaver.HttpTransformer.Compress.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.HttpTransformer.Image\SysWeaver.HttpTransformer.Image.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.AspHttpServer\SysWeaver.MicroService.AspHttpServer.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.Auth\SysWeaver.MicroService.Auth.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.Edit\SysWeaver.MicroService.Edit.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.FileUploader\SysWeaver.MicroService.FileUploader.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.FolderSync\SysWeaver.MicroService.FolderSync.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.HttpServer\SysWeaver.MicroService.HttpServer.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.Media\SysWeaver.MicroService.Media.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.MySqlAudit\SysWeaver.MicroService.MySqlAudit.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.NetHttpServer\SysWeaver.MicroService.NetHttpServer.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroService.ServerManager\SysWeaver.MicroService.ServerManager.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroServices.Log\SysWeaver.MicroServices.Log.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.MicroServices.ServiceManager\SysWeaver.MicroServices.ServiceManager.csproj" />
    <ProjectReference Include="..\..\SysWeaver\Platform\SysWeaver.OsServices.ServiceHostFactoryUnix\SysWeaver.OsServices.ServiceHostFactoryUnix.csproj" />
    <ProjectReference Include="..\..\SysWeaver\Platform\SysWeaver.OsServices.ServiceHostFactoryWin32NT\SysWeaver.OsServices.ServiceHostFactoryWin32NT.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.ReverseProxy\SysWeaver.ReverseProxy.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.Security.Acme\SysWeaver.Security.Acme.csproj" />
    <ProjectReference Include="..\..\SysWeaver\SysWeaver.Security\SysWeaver.Security.csproj" />
    <ProjectReference Include="..\..\SysWeaver\Serialization\SysWeaver.Serialization.SwJson\SysWeaver.Serialization.SwJson.csproj" />
  </ItemGroup>

  <!-- Optional: the Fenrir service (the internal SysWeaver.Temp repository next to this one). When it is there it is built with this project
       and its assemblies (with their dependencies) are copied to the build and publish output. No code uses it, so it is never loaded
       unless SwServerManager.Services.json adds the service by its type name; without the repository nothing changes. -->
  <PropertyGroup>
    <FenrirProject>$(MSBuildThisFileDirectory)..\..\SysWeaver.Temp\SysWeaver.MicroService.Fenrir\SysWeaver.MicroService.Fenrir.csproj</FenrirProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(FenrirProject)')">
    <ProjectReference Include="$(FenrirProject)" />
  </ItemGroup>

  <ItemGroup>
      <None Update="SwServerManager.Config.jsonxx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="SwServerManager.Services.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SwServerManager.Services.Linux.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
